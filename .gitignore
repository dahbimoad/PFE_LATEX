# ============================================================================
# .gitignore for the PFE Memoire LaTeX template
# ----------------------------------------------------------------------------
# Pure ASCII (no accented characters) so it renders the same on any editor.
# ============================================================================

# ---- latexmk build folder (everything in here is regenerable) -------------
build/

# ---- Final output --------------------------------------------------------
# The PDF is regenerated by `latexmk`. Uncomment the next line if you do NOT
# want to track the compiled PDF in git. By default we keep it tracked so
# the deliverable can be downloaded directly from the repo.
# output/

# Always ignore these inside output/ (only the .pdf should ever live there)
output/*.aux
output/*.log
output/*.synctex.gz
output/*.toc
output/*.lof
output/*.lot
output/*.out
output/*.bbl
output/*.blg
output/*.fdb_latexmk
output/*.fls

# ---- LaTeX intermediate files (in case anyone runs pdflatex by hand) ------
*.aux
*.bbl
*.bcf
*.blg
*.brf
*.fdb_latexmk
*.fls
*.idx
*.ilg
*.ind
*.lof
*.log
*.lot
*.loa
*.maf
*.mtc
*.mtc[0-9]*
*.nav
*.out
*.run.xml
*.snm
*.synctex
*.synctex.gz
*.synctex(busy)
*.toc
*.vrb
*.xdv

# minted / pythontex / etc.
_minted-*/
*.pyg
*.pytxcode
pythontex-files-*/

# ---- Editor / IDE --------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
*.bak

# ---- OS noise ------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
$RECYCLE.BIN/
